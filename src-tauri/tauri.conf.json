{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HANA-Lens",
  "version": "1.4.34",
  "identifier": "com.sap.hana-lens",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "HANA-Lens",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
